<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" type="text/css" href="/output.css" />
    <script src="/js/profile.js" defer></script>
</head>

<body class="min-h-full bg-gray-50">
    <header class="bg-white border-b">
        <div class="max-w-5xl mx-auto px-4 py-6 flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-semibold">Hello, <span class="text-blue-600"><%= displayName %></span>!</h1>
                <p class="text-gray-500">Welcome to your profile. Manage your posts below.</p>
            </div>
            <div class="space-x-3">
                <a href="/" class="px-4 py-2 bg-gray-800 text-white rounded hover:bg-black transition-colors">Home</a>
                <% if (locals.authenticated) { %>
                <a href="/upload" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-800">post a thread</a>
                <form action="/logout" method="post" class="inline">
                    <button type="submit" class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition-colors">Log Out</button>
                </form>
                <% } %>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
        <!-- Toolbar -->
<section class="max-w-5xl mx-auto mb-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-lg font-semibold text-gray-900">Your Threads</h2>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <form action="/profile" method="get" class="flex items-center gap-2">
        <input
          type="text"
          name="q"
          value="<%= typeof q !== 'undefined' ? q : '' %>"
          placeholder="Search your threads…"
          class="w-64 rounded-md border-0 ring-1 ring-inset ring-gray-300 px-3 py-2 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm"
        />
        <select
          name="status"
          class="rounded-md border-0 ring-1 ring-inset ring-gray-300 px-3 py-2 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm"
        >
          <option value="">All statuses</option>
          <option value="published">Published</option>
          <option value="draft">Draft</option>
          <option value="archived">Archived</option>
        </select>
        <button
          class="rounded-md bg-gray-800 px-3 py-2 text-sm text-white hover:bg-black transition-colors"
          type="submit"
        >
          Filter
        </button>
      </form>

      <a
        href="/upload"
        class="rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors text-center"
      >
        + New Thread
      </a>
    </div>
  </div>
</section>

<!-- Cards -->
<section class="max-w-5xl mx-auto">
  <% const myThreads = (typeof threads !== 'undefined' && threads && threads.length) ? threads : []; %>

  <% if (myThreads.length === 0) { %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center">
      <p class="text-gray-600">No threads yet.</p>
      <a href="/upload" class="inline-block mt-3 text-blue-600 hover:underline">Create your first thread</a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% myThreads.forEach(t => { %>
        <article class="bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-4 flex flex-col">
          <!-- Title + status/visibility -->
          <div class="mb-2 flex items-start justify-between gap-3">
            <h3 class="text-gray-900 font-semibold leading-6">
              <a href="/threads/<%= t.id %>" class="hover:underline"><%= t.title %></a>
            </h3>
            <div class="flex items-center gap-2">
              <!-- Status badge -->
              <% if (t.status === 'published') { %>
                <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-800">Published</span>
              <% } else if (t.status === 'draft') { %>
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-900">Draft</span>
              <% } else { %>
                <span class="inline-flex items-center rounded-md bg-red-100 px-2 py-1 text-xs font-medium text-red-700">Archived</span>
              <% } %>

              <!-- Visibility badge -->
              <% if (t.visibility === 'public') { %>
                <span class="inline-flex items-center rounded-md ring-1 ring-gray-300 px-2 py-1 text-xs text-gray-700">Public</span>
              <% } else if (t.visibility === 'private') { %>
                <span class="inline-flex items-center rounded-md ring-1 ring-gray-300 px-2 py-1 text-xs text-gray-700">Private</span>
              <% } else { %>
                <span class="inline-flex items-center rounded-md ring-1 ring-gray-300 px-2 py-1 text-xs text-gray-700">Unlisted</span>
              <% } %>
            </div>
          </div>

          <!-- Tags -->
          <% if (t.tags && t.tags.length) { %>
            <div class="mb-3 flex flex-wrap gap-2">
              <% t.tags.forEach(tag => { %>
                <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs text-gray-700">#<%= tag %></span>
              <% }) %>
            </div>
          <% } %>

          <!-- Meta -->
          <dl class="mb-4 grid grid-cols-3 gap-2 text-sm">
            <div class="rounded-md bg-gray-100 py-2 text-center">
              <dt class="text-gray-500">Views</dt>
              <dd class="font-semibold text-gray-900"><%= t.views %></dd>
            </div>
            <div class="rounded-md bg-gray-100 py-2 text-center">
              <dt class="text-gray-500">Comments</dt>
              <dd class="font-semibold text-gray-900"><%= t.comments %></dd>
            </div>
            <div class="rounded-md bg-gray-100 py-2 text-center">
              <dt class="text-gray-500">Likes</dt>
              <dd class="font-semibold text-gray-900"><%= t.likes %></dd>
            </div>
          </dl>

          <!-- Dates -->
          <p class="text-xs text-gray-500 mb-4">
            Created: <%= t.createdAt %> · Updated: <%= t.updatedAt %>
          </p>

          <!-- Actions -->
          <div class="mt-auto flex items-center gap-2">
            <a href="/threads/<%= t.id %>" class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm text-gray-900 hover:bg-gray-100 transition">View</a>
            <a href="/threads/<%= t.id %>/edit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm text-white hover:bg-indigo-500 transition">Edit</a>

            <% if (t.visibility === 'public') { %>
              <form action="/threads/<%= t.id %>/visibility" method="post">
                <input type="hidden" name="visibility" value="private"/>
                <button class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm hover:bg-gray-100 transition" type="submit">Make Private</button>
              </form>
            <% } else { %>
              <form action="/threads/<%= t.id %>/visibility" method="post">
                <input type="hidden" name="visibility" value="public"/>
                <button class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm hover:bg-gray-100 transition" type="submit">Make Public</button>
              </form>
            <% } %>

            <form action="/threads/<%= t.id %>/delete" method="post" class="ml-auto" onsubmit="return confirm('Delete this thread? This cannot be undone.');">
              <button class="rounded-md bg-red-500 px-3 py-2 text-sm text-white hover:bg-red-600 transition" type="submit">Delete</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>

    <!-- Pagination (mock) -->
    <div class="mt-6 flex items-center justify-center gap-2">
      <a href="?page=1" class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm hover:bg-gray-100">« First</a>
      <a href="?page=2" class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm hover:bg-gray-100">‹ Prev</a>
      <span class="text-sm text-gray-600">Page 3 of 12</span>
      <a href="?page=4" class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm hover:bg-gray-100">Next ›</a>
      <a href="?page=12" class="rounded-md ring-1 ring-gray-300 px-3 py-2 text-sm hover:bg-gray-100">Last »</a>
    </div>
  <% } %>
</section>

      </main>

      <!-- Include Footer -->
      <%- include('templates/footer') %>
    
</body>

</html>

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create Thread</title>
  <link rel="stylesheet" href="/output.css" />
</head>
<body class="min-h-screen bg-gray-50 flex flex-col">

  <!-- Top bar -->
  <header class="bg-white border-b sticky top-0 z-30">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    
    <!-- Back button -->
    <a href="/profile"
       class="inline-flex items-center gap-2 text-gray-700 hover:text-blue-600 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
           viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      <span class="font-medium text-sm">Back to Profile</span>
    </a>

    <!-- Avatar -->
    <a href="/account" class="group relative inline-flex items-center" title="Account">
      <img
        src="<%= avatar_url %>"
        alt="Account"
        class="h-10 w-10 rounded-full object-cover ring-2 ring-gray-200 group-hover:ring-blue-500 transition"
      />
      <span class="sr-only">Account</span>
    </a>
  </div>
</header>


  <!-- Main content -->
  <main class="fflex-grow max-w-5xl mx-auto w-full px-6 py-12 space-y-10">
    <div class="w-full max-w-2xl bg-white rounded-lg shadow-sm ring-1 ring-gray-200 p-8">
      <p class="text-gray-500 mb-6 text-center">
        Share a question, idea, or discussion topic.
      </p>

      <% if (error) { %>
        <div class="mb-6 rounded-md bg-red-50 p-4 ring-1 ring-red-200">
          <p class="text-sm font-medium text-red-700"><%= error %></p>
        </div>
      <% } %>

      <form class="space-y-6" method="post" action="/threads/create" novalidate>
        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-900">Title</label>
          <div class="mt-2">
            <input id="title" name="title" type="text" required minlength="5" maxlength="120"
              placeholder="E.g., What's the best stack for a student project?"
              class="block w-full rounded-md border-0 py-2 px-3 text-gray-900 shadow-sm
                     ring-1 ring-inset ring-gray-300 placeholder:text-gray-400
                     focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm" />
          </div>
        </div>

        <!-- Tags -->
        <div>
          <label for="tags" class="block text-sm font-medium text-gray-900">Tags (comma-separated)</label>
          <div class="mt-2">
            <input id="tags" name="tags" type="text" placeholder="mysql, tailwind, node"
              class="block w-full rounded-md border-0 py-2 px-3 text-gray-900 shadow-sm
                     ring-1 ring-inset ring-gray-300 placeholder:text-gray-400
                     focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm" />
          </div>
        </div>

        <!-- Body -->
        <div>
          <label for="body" class="block text-sm font-medium text-gray-900">Body</label>
          <div class="mt-2">
            <textarea id="body" name="body" rows="6" required
              placeholder="Describe your problem or start a discussion…"
              class="block w-full rounded-md border-0 py-2 px-3 text-gray-900 shadow-sm
                     ring-1 ring-inset ring-gray-300 placeholder:text-gray-400
                     focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm"></textarea>
          </div>
        </div>

        

        <!-- Buttons -->
        <div class="flex items-center justify-between pt-4">
          <button type="submit"
            class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2
                   text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition">
            Save Thread
          </button>

          <a href="/profile"
             class="inline-flex items-center justify-center rounded-full ring-1 ring-gray-300
                    text-gray-900 hover:bg-gray-100 transition h-10 w-10"
             title="Back to profile">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
          </a>
        </div>
      </form>
    </div>
  </main>

  <%- include('templates/footer') %>
</body>
</html>

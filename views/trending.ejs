<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <title>Trending Threads</title>
  <link rel="stylesheet" href="/output.css" />
  <script>window.DEFAULT_AVATAR_URL = "<%= default_avatar_url %>";</script>
</head>

<body class="min-h-screen bg-gray-50 flex flex-col">
  <!-- Header -->
  <header class="bg-white border-b">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
    <!-- Left: Site Title -->
    <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold">Discussion Platform</a>

    <!-- Right: Navigation / Auth Buttons -->
    <div class="flex items-center gap-3">
      <% if (locals.authenticated) { %>
        <a href="/" class="px-3 py-2 text-sm bg-gray-900 text-white rounded hover:bg-black transition">Home</a>
        <a href="/upload" class="px-3 py-2 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition">New Thread</a>
        <a href="/profile"
           class="h-10 w-10 flex items-center justify-center rounded-full overflow-hidden ring-2 ring-gray-200 hover:ring-blue-400 transition"
           title="Profile">
          <img src="<%= avatar_url %>" alt="Profile" class="h-full w-full object-cover rounded-full" />
        </a>
      <% } else { %>
        <a href="/" class="px-3 py-2 text-sm bg-gray-900 text-white rounded hover:bg-black transition">Home</a>
        <a href="/login" class="px-3 py-2 text-sm bg-green-600 text-white rounded hover:bg-green-700 transition">Log In</a>
        <a href="/signup" class="px-3 py-2 text-sm bg-blue-600 text-white rounded hover:bg-blue-700 transition">Sign Up</a>
      <% } %>
    </div>
  </div>
</header>


  <!-- Main -->
  <main class="flex-1 pb-20">
    <div class="max-w-5xl mx-auto px-4 mt-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">🔥 Trending Threads</h1>

      <% if (error) { %>
        <div class="mb-6 rounded-md bg-red-50 p-4 ring-1 ring-red-200 text-sm text-red-700"><%= error %></div>
      <% } %>

      <% if (threads && threads.length) { %>
        <div id="feed" class="space-y-4 " style="width: 100%; min-width: 340px; max-width: 640px; margin: 0 auto; padding-left: 1rem; padding-right: 1rem;">
          <% threads.forEach(thread => { %>
            <article
              class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 cursor-pointer hover:shadow-md transition-shadow"
              onclick="loadThread('<%= thread.thread_id %>')">
              <div class="flex items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <h2 class="text-lg font-semibold text-gray-900 hover:text-blue-600 transition-colors truncate">
                    <%= thread.title %>
                  </h2>
                  <div class="flex items-center gap-3 text-sm text-gray-500 mt-1">
  <img src="<%= thread.author_avatar_url || default_avatar_url %>"
       alt="<%= thread.username %>"
       class="h-6 w-6 rounded-full object-cover ring-1 ring-gray-200 shrink-0" />
  <span>by <strong><%= thread.username %></strong></span>
  <span class="mx-2">•</span>
  <time datetime="<%= thread.created_at %>">
    <%= new Date(thread.created_at).toLocaleDateString() %>
  </time>
</div>
                </div>

                <div class="ml-4 shrink-0 flex items-center space-x-4 text-sm text-gray-500">
                  <% if (thread.views > 0) { %>
                    <span class="flex items-center">Views: <%= thread.views %></span>
                  <% } %>

                  <% if (thread.comments_count > 0) { %>
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                      </svg>
                      <%= thread.comments_count %>
                    </span>
                  <% } %>

                  <% if (thread.likes_count > 0) { %>
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                      </svg>
                      <%= thread.likes_count %>
                    </span>
                  <% } %>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-gray-500 text-center mt-10">No trending threads yet.</p>
      <% } %>
    </div>
  </main>

  <%- include('templates/threadModal') %>
  <%- include('templates/footer') %>
  <script src="/js/threadModal.js"></script>
</body>
</html>
